{
  "name": "karen",
  "productName": "Karen",
  "version": "0.1.0",
  "description": "A local-first desktop Git client (no account, cloud, team or licensing features).",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "package:mac": "bash scripts/build-mac.sh",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "zustand": "^5.0.15"
  }
}
