{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karen",
  "version": "1.0.2",
  "identifier": "dev.karen.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["karen"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBNkIzRkQ1Q0UwNjNDQ0IKUldUTFBBYk8xVDlyK3JHZS9Ha1Erd0laY01XMjhxajlTV0pZdDhTWlBLcGxCRzRwRi9pUkZCTXQK",
      "endpoints": ["https://github.com/trungbkit/git-karen/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
